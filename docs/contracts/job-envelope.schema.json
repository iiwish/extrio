{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.extrio.dev/job-envelope.v1.schema.json",
  "title": "Extrio JobEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageType", "messageVersion", "jobId", "tenantId", "payloadRef", "payloadDigest", "audience", "fenceToken", "issuedAt", "expiresAt", "nonce", "attestation"],
  "properties": {
    "schemaVersion": {"const": "extrio.job-envelope.v1"},
    "messageType": {"enum": ["compile", "run", "validation_replay"]},
    "messageVersion": {"$ref": "#/$defs/semver"},
    "jobId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "payloadRef": {"$ref": "#/$defs/id"},
    "payloadDigest": {"$ref": "#/$defs/digest"},
    "audience": {"$ref": "#/$defs/id"},
    "fenceToken": {"type": "integer", "minimum": 1},
    "issuedAt": {"$ref": "#/$defs/timestamp"},
    "expiresAt": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$"},
    "traceparent": {"type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "attestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "algorithm", "keyId", "signerServiceId", "signedAt", "envelopeDigest", "signature"],
      "properties": {
        "purpose": {"const": "extrio-job-envelope-v1"},
        "algorithm": {"const": "Ed25519"},
        "keyId": {"$ref": "#/$defs/id"},
        "signerServiceId": {"$ref": "#/$defs/id"},
        "signedAt": {"$ref": "#/$defs/timestamp"},
        "envelopeDigest": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
