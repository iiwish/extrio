{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.extrio.dev/artifact-manifest.v1.schema.json",
  "title": "Extrio ArtifactManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "tenantId",
    "classification",
    "evidenceMode",
    "executionRef",
    "runtime",
    "completeness",
    "capturePolicyId",
    "retention",
    "createdAt",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "extrio.artifact-manifest.v1"},
    "manifestId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "classification": {"enum": ["internal", "confidential", "restricted"]},
    "evidenceMode": {"enum": ["metadata_only", "sampled", "replayable"]},
    "executionRef": {"$ref": "#/$defs/executionRef"},
    "parentManifestId": {"$ref": "#/$defs/id"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "completeness": {"$ref": "#/$defs/completeness"},
    "capturePolicyId": {"$ref": "#/$defs/id"},
    "samples": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/sampleEvidence"}
    },
    "responseChunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/chunkRef"}
    },
    "retention": {"$ref": "#/$defs/retention"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "manifestDigest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidenceMode": {"const": "metadata_only"}}, "required": ["evidenceMode"]},
      "then": {
        "properties": {
          "completeness": {
            "type": "object",
            "properties": {"complete": {"const": false}, "capturedResponseCount": {"const": 0}},
            "required": ["complete", "capturedResponseCount"]
          }
        },
        "not": {
          "anyOf": [
            {"required": ["samples"], "properties": {"samples": {"type": "array"}}},
            {"required": ["responseChunks"], "properties": {"responseChunks": {"type": "array"}}}
          ]
        }
      }
    },
    {
      "if": {"properties": {"evidenceMode": {"const": "sampled"}}, "required": ["evidenceMode"]},
      "then": {
        "required": ["samples"],
        "properties": {
          "samples": {"type": "array", "minItems": 1},
          "completeness": {
            "type": "object",
            "properties": {"complete": {"const": false}, "capturedResponseCount": {"type": "integer", "minimum": 1}},
            "required": ["complete", "capturedResponseCount"]
          }
        },
        "not": {"required": ["responseChunks"], "properties": {"responseChunks": {"type": "array"}}}
      }
    },
    {
      "if": {"properties": {"evidenceMode": {"const": "replayable"}}, "required": ["evidenceMode"]},
      "then": {
        "required": ["responseChunks"],
        "properties": {
          "responseChunks": {"type": "array", "minItems": 1},
          "completeness": {
            "type": "object",
            "properties": {"complete": {"const": true}, "capturedResponseCount": {"type": "integer", "minimum": 1}},
            "required": ["complete", "capturedResponseCount"]
          }
        },
        "not": {"required": ["samples"], "properties": {"samples": {"type": "array"}}}
      }
    },
    {
      "if": {
        "properties": {
          "executionRef": {
            "type": "object",
            "properties": {"kind": {"const": "validation_replay"}},
            "required": ["kind"]
          }
        },
        "required": ["executionRef"]
      },
      "then": {"required": ["parentManifestId"], "properties": {"parentManifestId": {"$ref": "#/$defs/id"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 8192},
    "executionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "executionId", "collectionVersionId", "sourceRevisionId"],
      "properties": {
        "kind": {"enum": ["compile", "run", "validation_replay"]},
        "executionId": {"$ref": "#/$defs/id"},
        "attemptId": {"$ref": "#/$defs/id"},
        "ruleVersionId": {"$ref": "#/$defs/id"},
        "collectionVersionId": {"$ref": "#/$defs/id"},
        "sourceRevisionId": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["run", "validation_replay"]}}, "required": ["kind"]},
          "then": {"required": ["ruleVersionId"], "properties": {"ruleVersionId": {"$ref": "#/$defs/id"}}}
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "deviceScaleFactor"],
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 4320},
        "deviceScaleFactor": {"type": "number", "minimum": 1, "maximum": 4}
      }
    },
    "browserContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engineVersion", "viewport", "locale", "timezoneId"],
      "properties": {
        "engine": {"const": "chromium"},
        "engineVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "viewport": {"$ref": "#/$defs/viewport"},
        "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "timezoneId": {"type": "string", "pattern": "^(UTC|[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+)$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeName", "runtimeVersion", "parserVersion", "dialectVersion", "tzdbVersion", "unicodeVersion"],
      "properties": {
        "runtimeName": {"$ref": "#/$defs/id"},
        "runtimeVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "parserVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "dialectVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "tzdbVersion": {"type": "string", "pattern": "^[0-9]{4}[a-z]$"},
        "unicodeVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        "browserContext": {"$ref": "#/$defs/browserContext"}
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "capturedResponseCount", "totalResponseCount"],
      "properties": {
        "complete": {"type": "boolean"},
        "capturedResponseCount": {"type": "integer", "minimum": 0},
        "totalResponseCount": {"type": "integer", "minimum": 0}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "objectVersion", "digest", "bytes"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/id"},
        "objectVersion": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}
      }
    },
    "sampleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sequence", "stage", "requestPlanDigest", "finalUrl", "status"],
      "properties": {
        "requestId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "stage": {"enum": ["list", "detail", "browser_document", "sample"]},
        "requestPlanDigest": {"$ref": "#/$defs/digest"},
        "finalUrl": {"$ref": "#/$defs/url"},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "decodedBody": {"$ref": "#/$defs/objectRef"},
        "domSnapshot": {"$ref": "#/$defs/objectRef"}
      }
    },
    "chunkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunkId", "sequenceStart", "sequenceEnd", "responseCount", "objectVersion", "digest", "bytes"],
      "properties": {
        "chunkId": {"$ref": "#/$defs/id"},
        "sequenceStart": {"type": "integer", "minimum": 0},
        "sequenceEnd": {"type": "integer", "minimum": 0},
        "responseCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "objectVersion": {"type": "string", "minLength": 1, "maxLength": 256},
        "digest": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retainUntil", "policyId"],
      "properties": {
        "retainUntil": {"$ref": "#/$defs/timestamp"},
        "policyId": {"$ref": "#/$defs/id"},
        "legalHold": {"type": "boolean"}
      }
    }
  }
}
